{
  "name": "dsh-provider-quick-config",
  "version": "0.2.4",
  "private": true,
  "description": "发送键旁 + 号快速配置模型 Provider（llm-pi-ai 路由/模型/密钥），本地模型 60s 自动同步。正式安装形态：dsh.bundle 挂 Host，dsh.client 挂 Web UI。",
  "main": "src/host.js",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
